# Copy to backend/.env and fill in. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string
# DATABASE_URL defaults to backend/drowsiguard.db (absolute path)
# DATABASE_URL=sqlite:///./drowsiguard.db
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:8000

# Optional: path to a trained model artifact (defaults to ml/models/drowsiness_model.json)
# MODEL_PATH=../ml/models/drowsiness_model.json

# --- Phone-call escalation (Twilio). Leave empty to run in "simulated" mode. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Seconds between escalations for the same user (prevents call spam)
ESCALATION_COOLDOWN_SECONDS=60

# --- Smartwatch alerts (phone notification via ntfy, mirrored to the watch) ---
NTFY_SERVER=https://ntfy.sh

# --- R insights (path to Rscript if it is not on PATH) ---
# RSCRIPT_PATH=C:\Program Files\R\R-4.4.2\bin\Rscript.exe
